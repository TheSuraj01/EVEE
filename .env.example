# Copy to .env for local development. .env is gitignored and must never be committed,
# packaged into an executable, or pasted into an issue.
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=4
GROQ_MAX_RETRIES=1

# Any config key can be overridden with VOICE_AGENT__<SECTION>__<KEY>
# VOICE_AGENT__LLM__ENABLED=false
